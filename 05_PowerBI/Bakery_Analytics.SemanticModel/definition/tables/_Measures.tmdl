table _Measures
	lineageTag: 5825a39d-cc4f-4d09-b2dd-2581551019cd

	measure 'Total Income' = SUM(FactSalesHeader[NetAmount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: BASE MEASURES
		lineageTag: e2205443-520f-41c5-b97f-95f074559877

	measure 'Total Expenses' =
			
			SUM(FactExpense[ExpenseAmount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: BASE MEASURES
		lineageTag: 96039ba4-2165-41ca-a428-9481f40cbe24

	measure 'Net Profit' =
			
			[Total Income] - [Total Expenses]
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: BASE MEASURES
		lineageTag: bc5762d1-2d6b-4506-bdb2-3a2ca6724915

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'Profit Margin %' =
			
			DIVIDE([Net Profit], [Total Income], 0)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: BASE MEASURES
		lineageTag: 5df7ecc4-c262-4e88-b3c3-45ae9c7eead7

	measure 'Payments Received' =
			
			CALCULATE(
			    SUM(FactPayment[PaymentAmount]),
			    FactPayment[PaymentStatus] = "Received"
			)
		formatString: "Rs"#,0.###############;-"Rs"#,0.###############;"Rs"#,0.###############
		displayFolder: BASE MEASURES
		lineageTag: 995ecd0a-36a6-4ddc-ac91-3108d7da5269

		annotation PBI_FormatHint = {"currencyCulture":"en-PK"}

	measure 'Payments Pending' = ```
			
			VAR Pending = CALCULATE(SUM(FactPayment[PaymentAmount]), FactPayment[PaymentStatus] = "Pending")
			RETURN Pending 
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: BASE MEASURES
		lineageTag: 2e94578c-58d4-4531-99b0-64cd6b19fed4

	measure 'Collection Rate %' =
			
			DIVIDE([Payments Received], [Total Income], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BASE MEASURES
		lineageTag: 0e1de07d-32a6-448f-a1b9-cb349561ea48

	measure 'Expense % of Total' =
			
			DIVIDE(
			    [Total Expenses],
			    CALCULATE([Total Expenses], REMOVEFILTERS(DimExpCategory)),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREAKDOWN MEASURES
		lineageTag: c875bdf3-5705-4cfc-b105-fad4b25b7551

	measure 'Expense % of Revenue' = ```
			
