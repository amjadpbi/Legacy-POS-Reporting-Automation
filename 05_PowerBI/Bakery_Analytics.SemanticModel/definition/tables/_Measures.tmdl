			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREAKDOWN MEASURES
		lineageTag: d641de40-c502-443d-84da-7f31a45c8b5d

	measure 'Payment Method % of Total' =
			
			DIVIDE(
			    [Total Income],
			    CALCULATE([Total Income], REMOVEFILTERS(DimPaymentMethod)),
			    0
			)
		displayFolder: BREAKDOWN MEASURES
		lineageTag: ecb54ac6-a793-4988-8444-f1fbb4ac159a

